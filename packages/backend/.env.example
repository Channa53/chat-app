# Server
PORT=4000
NODE_ENV=development

# CORS — frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://USER@localhost:5432/chat_app
# DATABASE_URL_TEST=postgresql://USER@localhost:5432/chat_app_test

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
