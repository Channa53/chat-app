// Prisma schema for the chat app
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ChatRoomType {
  DIRECT
  GROUP
}

enum ChatRoomMemberRole {
  MEMBER
  ADMIN
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         UserRole @default(USER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   ChatRoomMember[]
  messages      Message[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model ChatRoom {
  id        String       @id @default(cuid())
  name      String?
  type      ChatRoomType
  createdAt DateTime     @default(now())

  members  ChatRoomMember[]
  messages Message[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  userId   String
  roomId   String
  role     ChatRoomMemberRole @default(MEMBER)
  joinedAt DateTime           @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([roomId])
  @@map("chat_room_members")
}

model Message {
  id        String    @id @default(cuid())
  content   String
  senderId  String
  roomId    String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId])
  @@map("messages")
}
